              "required": [
                "kind",
                "nodeId"
              ],
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": [
                    "modelProfile"
                  ]
                },
                {
                  "required": [
                    "prompt"
                  ]
                }
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "loop_limit"
                },
                "nodeId": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
