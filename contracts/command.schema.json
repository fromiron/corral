                      "minimum": 1,
                      "maximum": 100
                    },
                    "maxOutputTokens": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 256000
                    }
                  },
                  "required": [],
                  "additionalProperties": false,
                  "minProperties": 1
                }
              },
              "required": [
                "kind",
                "changes"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "criteria"
                },
                "baseCriteriaVersionId": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
                },
                "criteria": {
                  "type": "array",
