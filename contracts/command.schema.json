    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "0.1"
        },
        "commandId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
        },
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
        },
        "expectedControlRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "type": {
          "const": "steer"
        },
        "payload": {
          "type": "object",
          "properties": {
            "targetExecutionId": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 12000
            },
            "delivery": {
              "const": "next_request"
            }
          },
          "required": [
            "targetExecutionId",
            "text",
            "delivery"
