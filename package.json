{
  "name": "corral",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "spec:check": "node tools/spec-check/spec-check.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --no-bail typecheck && tsc -p tools/tsconfig.json && tsc -p tests/live/tsconfig.json",
    "test": "vitest run",
    "build": "pnpm -r build",
    "test:e2e": "pnpm --filter @corral/studio test:e2e",
    "dev": "pnpm --filter @corral/studio dev",
    "corral": "node packages/cli/src/main.ts",
    "serve": "pnpm --filter @corral/studio build && node apps/server/src/main.ts --static apps/studio/dist",
    "storybook": "pnpm --filter @corral/react storybook",
    "deps:record": "node tools/deps/record.ts",
    "deps:check": "node tools/deps/check.ts",
    "contracts:generate": "node tools/contracts/generate.ts",
    "contracts:check": "node tools/contracts/generate.ts --check",
    "test:live": "vitest run --config tests/live/vitest.config.ts",
    "test:performance": "pnpm --filter @corral/studio exec playwright test --config playwright.performance.config.ts",
    "release:inventory": "node tools/release/inventory.ts",
    "release:gate": "node tools/release/gate.ts",
    "release:check": "node tools/release/check.ts",
    "test:release": "node --test tools/release/*.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "semver": "7.8.5",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
