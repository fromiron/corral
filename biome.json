{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "tools/**/*.ts",
      "tools/**/*.json",
      "tests/live/**/*.ts",
      "tests/live/**/*.json",
      "*.ts",
      "biome.json",
      "package.json",
      "tsconfig.base.json",
      "!packages/contracts/generated",
      "!packages/core/src/generated",
      "!apps/server/resources/builtin/design"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": { "inputComponents": ["Input", "Textarea", "Select"] }
        }
      }
    }
  },
  "assist": {
    "enabled": true
  },
  "overrides": [
    {
      "includes": ["packages/react/src/design-kit/tokens.css"],
      "formatter": { "enabled": false }
    },
    {
      "includes": ["packages/contracts/**", "packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["node:*", "node:*/**"],
                    "message": "contracts/core must stay runtime-neutral. Inject the capability instead."
                  },
                  {
                    "group": [
                      "assert",
                      "assert/**",
                      "async_hooks",
                      "async_hooks/**",
                      "buffer",
                      "buffer/**",
                      "child_process",
                      "child_process/**",
                      "cluster",
                      "cluster/**",
                      "console",
                      "console/**",
                      "constants",
                      "constants/**",
                      "crypto",
                      "crypto/**",
                      "dgram",
                      "dgram/**",
                      "diagnostics_channel",
                      "diagnostics_channel/**",
                      "dns",
                      "dns/**",
                      "domain",
                      "domain/**",
                      "events",
                      "events/**",
                      "fs",
                      "fs/**",
                      "http",
                      "http/**",
                      "http2",
                      "http2/**",
                      "https",
                      "https/**",
                      "inspector",
                      "inspector/**",
                      "module",
                      "module/**",
                      "net",
                      "net/**",
                      "os",
                      "os/**",
                      "path",
                      "path/**",
                      "perf_hooks",
                      "perf_hooks/**",
                      "process",
                      "process/**",
                      "punycode",
                      "punycode/**",
                      "querystring",
                      "querystring/**",
                      "readline",
                      "readline/**",
                      "repl",
                      "repl/**",
                      "stream",
                      "stream/**",
                      "string_decoder",
                      "string_decoder/**",
                      "sys",
                      "sys/**",
                      "timers",
                      "timers/**",
                      "tls",
                      "tls/**",
                      "trace_events",
                      "trace_events/**",
                      "tty",
                      "tty/**",
                      "url",
                      "url/**",
                      "util",
                      "util/**",
                      "v8",
                      "v8/**",
                      "vm",
                      "vm/**",
                      "wasi",
                      "wasi/**",
                      "worker_threads",
                      "worker_threads/**",
                      "zlib",
                      "zlib/**"
                    ],
                    "message": "contracts/core must stay runtime-neutral."
                  }
                ],
                "paths": {
                  "react": "contracts/core must not depend on React.",
                  "react-dom": "contracts/core must not depend on React."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/studio/src/**",
        "packages/react/src/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/test/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "node:*",
                      "node:*/**",
                      "assert",
                      "assert/**",
                      "async_hooks",
                      "async_hooks/**",
                      "buffer",
                      "buffer/**",
                      "child_process",
                      "child_process/**",
                      "cluster",
                      "cluster/**",
                      "console",
                      "console/**",
                      "constants",
                      "constants/**",
                      "crypto",
                      "crypto/**",
                      "dgram",
                      "dgram/**",
                      "diagnostics_channel",
                      "diagnostics_channel/**",
                      "dns",
                      "dns/**",
                      "domain",
                      "domain/**",
                      "events",
                      "events/**",
                      "fs",
                      "fs/**",
                      "http",
                      "http/**",
                      "http2",
                      "http2/**",
                      "https",
                      "https/**",
                      "inspector",
                      "inspector/**",
                      "module",
                      "module/**",
                      "net",
                      "net/**",
                      "os",
                      "os/**",
                      "path",
                      "path/**",
                      "perf_hooks",
                      "perf_hooks/**",
                      "process",
                      "process/**",
                      "punycode",
                      "punycode/**",
                      "querystring",
                      "querystring/**",
                      "readline",
                      "readline/**",
                      "repl",
                      "repl/**",
                      "stream",
                      "stream/**",
                      "string_decoder",
                      "string_decoder/**",
                      "sys",
                      "sys/**",
                      "timers",
                      "timers/**",
                      "tls",
                      "tls/**",
                      "trace_events",
                      "trace_events/**",
                      "tty",
                      "tty/**",
                      "url",
                      "url/**",
                      "util",
                      "util/**",
                      "v8",
                      "v8/**",
                      "vm",
                      "vm/**",
                      "wasi",
                      "wasi/**",
                      "worker_threads",
                      "worker_threads/**",
                      "zlib",
                      "zlib/**"
                    ],
                    "message": "Studio and packages/react run in the browser and in the sandboxed desktop renderer, where Node built-ins do not exist. In Studio, ask the server through @corral/client (see apps/studio/src/services.tsx) or the desktop shell through window.corralDesktop (typed in apps/studio/src/desktop.tsx); in packages/react, take the data or the action as a prop from the app."
                  },
                  {
                    "group": ["electron/**"],
                    "message": "Studio and packages/react run in the browser and in the sandboxed desktop renderer, where Electron's modules are not available. Expose the capability in a preload under apps/desktop/src and call it from Studio through its bridge (window.corralDesktop, typed in apps/studio/src/desktop.tsx); packages/react takes it as a prop from the app."
                  },
                  {
                    "group": ["@corral/server/**"],
                    "message": "Studio and packages/react must not bundle server code. Studio reaches server data through @corral/client, and packages/react takes it as a prop from the app; shared types and schemas live in @corral/contracts."
                  }
                ],
                "paths": {
                  "electron": "Studio and packages/react run in the browser and in the sandboxed desktop renderer, where Electron's modules are not available. Expose the capability in a preload under apps/desktop/src and call it from Studio through its bridge (window.corralDesktop, typed in apps/studio/src/desktop.tsx); packages/react takes it as a prop from the app.",
                  "@corral/server": "Studio and packages/react must not bundle server code. Studio reaches server data through @corral/client, and packages/react takes it as a prop from the app; shared types and schemas live in @corral/contracts."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/test/**", "**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
