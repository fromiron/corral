{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "tools/**/*.ts",
      "tools/**/*.json",
      "tests/live/**/*.ts",
      "tests/live/**/*.json",
      "*.ts",
      "biome.json",
      "package.json",
      "tsconfig.base.json",
      "!packages/contracts/generated",
      "!apps/server/resources/builtin/design"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": { "inputComponents": ["Input", "Textarea", "Select"] }
        }
      }
    }
  },
  "assist": {
    "enabled": true
  },
  "overrides": [
    {
      "includes": ["packages/react/src/design-kit/tokens.css"],
      "formatter": { "enabled": false }
    },
    {
      "includes": ["packages/contracts/**", "packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["node:*"],
                    "message": "contracts/core must stay runtime-neutral. Inject the capability instead."
                  }
                ],
                "paths": {
                  "react": "contracts/core must not depend on React.",
                  "react-dom": "contracts/core must not depend on React.",
                  "fs": "contracts/core must stay runtime-neutral.",
                  "path": "contracts/core must stay runtime-neutral.",
                  "crypto": "contracts/core must stay runtime-neutral.",
                  "buffer": "contracts/core must stay runtime-neutral.",
                  "child_process": "contracts/core must stay runtime-neutral."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/test/**", "**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
