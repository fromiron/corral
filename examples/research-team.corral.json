{
  "schemaVersion": "0.1",
  "id": "research_write_review",
  "name": "조사·작성·검토 Corral",
  "entryNodeId": "research",
  "input": {
    "brief": "공개 1차 자료를 바탕으로 두 가지 도입 대안을 비교한다.",
    "criteria": [
      "근거 자료의 출처를 명시한다.",
      "장점과 제약을 모두 설명한다."
    ]
  },
  "roles": [
    {
      "id": "researcher",
      "name": "조사 담당",
      "prompt": "조사 담당 역할을 수행한다. 제공된 작업과 입력만 사용하고, 근거 참조와 정확한 산출물 버전을 유지한다. 완료는 submit_result로 제출한다. 도구 실패나 자료 부족을 숨기지 않는다.",
      "modelProfile": "model-a",
      "allowedWorkTools": [
        "search",
        "read_document",
        "write_artifact"
      ],
      "allowedCollaborationTools": [
        "spawn_subagents",
        "await_tasks",
        "read_artifact",
        "reply",
        "submit_result"
      ],
      "outputContract": "notes"
    },
    {
      "id": "helper",
      "name": "자료 탐색 담당",
      "prompt": "자료 탐색 담당 역할을 수행한다. 제공된 작업과 입력만 사용하고, 근거 참조와 정확한 산출물 버전을 유지한다. 완료는 submit_result로 제출한다. 도구 실패나 자료 부족을 숨기지 않는다.",
      "modelProfile": "model-b",
      "allowedWorkTools": [
        "search",
        "read_document",
        "write_artifact"
      ],
      "allowedCollaborationTools": [
        "read_artifact",
        "submit_result"
      ],
      "outputContract": "notes"
    },
    {
      "id": "writer",
      "name": "작성 담당",
      "prompt": "작성 담당 역할을 수행한다. 제공된 작업과 입력만 사용하고, 근거 참조와 정확한 산출물 버전을 유지한다. 완료는 submit_result로 제출한다. 도구 실패나 자료 부족을 숨기지 않는다.",
      "modelProfile": "model-a",
      "allowedWorkTools": [
        "write_artifact"
      ],
      "allowedCollaborationTools": [
        "ask",
        "read_artifact",
        "submit_result"
      ],
      "outputContract": "draft"
    },
    {
      "id": "reviewer",
      "name": "검토 담당",
      "prompt": "검토 담당 역할을 수행한다. 제공된 작업과 입력만 사용하고, 근거 참조와 정확한 산출물 버전을 유지한다. 완료는 submit_result로 제출한다. 도구 실패나 자료 부족을 숨기지 않는다.",
      "modelProfile": "model-b",
      "allowedWorkTools": [
        "write_artifact"
      ],
      "allowedCollaborationTools": [
        "read_artifact",
        "submit_result"
      ],
      "outputContract": "review"
    }
  ],
  "nodes": [
    {
      "id": "research",
      "type": "agent",
      "label": "조사",
      "roleId": "researcher",
      "invocation": "scheduled",
      "inputBindings": [
        {
          "kind": "run_input",
          "name": "brief"
        }
      ],
      "outputName": "notes"
    },
    {
      "id": "helper",
      "type": "agent",
      "label": "자료 탐색",
      "roleId": "helper",
      "invocation": "callable",
      "inputBindings": [
        {
          "kind": "run_input",
          "name": "brief"
        }
      ],
      "outputName": "notes_part"
    },
    {
      "id": "respond",
      "type": "agent",
      "label": "질문 응답",
      "roleId": "researcher",
      "invocation": "callable",
      "inputBindings": [
        {
          "kind": "run_input",
          "name": "brief"
        }
      ],
      "outputName": "answer_notes"
    },
    {
      "id": "review_loop",
      "type": "loop",
      "label": "검토 반복",
      "maxIterations": 2
    },
    {
      "id": "write",
      "type": "agent",
      "label": "작성",
      "loopId": "review_loop",
      "roleId": "writer",
      "invocation": "scheduled",
      "inputBindings": [
        {
          "kind": "task_output",
          "name": "notes",
          "sourceNodeId": "research"
        },
        {
          "kind": "previous_iteration_output",
          "name": "draft",
          "sourceNodeId": "write",
          "optional": true
        },
        {
          "kind": "previous_iteration_output",
          "name": "review",
          "sourceNodeId": "review",
          "optional": true
        }
      ],
      "outputName": "draft"
    },
    {
      "id": "review",
      "type": "agent",
      "label": "검토",
      "loopId": "review_loop",
      "roleId": "reviewer",
      "invocation": "scheduled",
      "inputBindings": [
        {
          "kind": "task_output",
          "name": "draft",
          "sourceNodeId": "write"
        }
      ],
      "outputName": "review"
    },
    {
      "id": "review_decision",
      "type": "decision",
      "label": "검토 판정",
      "loopId": "review_loop",
      "mode": "review",
      "rule": "review_verdict",
      "inputBindings": [
        {
          "kind": "task_output",
          "name": "review",
          "sourceNodeId": "review"
        }
      ]
    },
    {
      "id": "approval",
      "type": "decision",
      "label": "최종 승인",
      "mode": "approval",
      "rule": "human_approval",
      "inputBindings": [
        {
          "kind": "task_output",
          "name": "draft",
          "sourceNodeId": "write"
        }
      ]
    },
    {
      "id": "output",
      "type": "output",
      "label": "최종 결과",
      "inputBindings": [
        {
          "kind": "task_output",
          "name": "draft",
          "sourceNodeId": "write"
        }
      ],
      "requireApproval": true
    }
  ],
  "controlEdges": [
    {
      "id": "e1",
      "source": "research",
      "sourcePort": "out",
      "target": "review_loop",
      "targetPort": "enter"
    },
    {
      "id": "e2",
      "source": "review_loop",
      "sourcePort": "body",
      "target": "write",
      "targetPort": "in"
    },
    {
      "id": "e3",
      "source": "write",
      "sourcePort": "out",
      "target": "review",
      "targetPort": "in"
    },
    {
      "id": "e4",
      "source": "review",
      "sourcePort": "out",
      "target": "review_decision",
      "targetPort": "in"
    },
    {
      "id": "e5",
      "source": "review_decision",
      "sourcePort": "revise",
      "target": "review_loop",
      "targetPort": "repeat"
    },
    {
      "id": "e6",
      "source": "review_decision",
      "sourcePort": "pass",
      "target": "review_loop",
      "targetPort": "exit"
    },
    {
      "id": "e7",
      "source": "review_loop",
      "sourcePort": "next",
      "target": "approval",
      "targetPort": "in"
    },
    {
      "id": "e8",
      "source": "approval",
      "sourcePort": "approve",
      "target": "output",
      "targetPort": "in"
    }
  ],
  "capabilityLinks": [
    {
      "id": "cap1",
      "kind": "delegate",
      "sourceNodeId": "research",
      "targetNodeId": "helper"
    },
    {
      "id": "cap2",
      "kind": "question",
      "sourceNodeId": "write",
      "targetNodeId": "respond"
    },
    {
      "id": "cap3",
      "kind": "delegate",
      "sourceNodeId": "respond",
      "targetNodeId": "helper"
    }
  ],
  "limits": {
    "maxDelegationDepth": 2,
    "maxModelConcurrency": 3,
    "maxSpawns": 12,
    "maxModelCalls": 40,
    "maxOutputTokens": 64000,
    "maxOutputTokensPerCall": 4096,
    "maxQuestions": 6,
    "questionTimeoutMs": 120000,
    "modelTimeoutMs": 180000,
    "runDeadlineMs": 3600000
  }
}
