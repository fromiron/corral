{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design token proposal",
  "description": "Token proposal rendered by scripts/render_token_proposal.py. In normalize mode every stated value is observed and traced to evidence. In new-system mode a value may be a design hypothesis with a rationale. Values with neither must be \"unknown\".",
  "type": "object",
  "required": [
    "project",
    "language",
    "title",
    "summary",
    "status",
    "prepared",
    "evidence_basis",
    "foundations",
    "changes",
    "decisions"
  ],
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "proposed"
    },
    "mode": {
      "enum": [
        "normalize",
        "new-system"
      ],
      "description": "normalize (default): consolidate an existing system from evidence. new-system: the user asked for a new system without existing tokens."
    },
    "approach": {
      "enum": [
        "auto",
        "guided"
      ],
      "description": "auto (default): the AI analyzed the project or brief. guided: the user answered questions from assets/token-questions.json first."
    },
    "preferences": {
      "type": "array",
      "description": "Guided answers. Required and non-empty when approach is guided; not allowed otherwise.",
      "items": {
        "type": "object",
        "required": [
          "question",
          "choice"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "description": "A core or follow-up question ID from assets/token-questions.json."
          },
          "choice": {
            "type": "string",
            "minLength": 1,
            "description": "An option ID from the question bank, \"delegate\" when the user let the AI choose, or \"custom\" for a written answer."
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "description": "The written answer; only with choice \"custom\". A color is written as hex, rgb(), rgba(), or oklch()."
          }
        }
      }
    },
    "prepared": {
      "type": "string",
      "minLength": 1
    },
    "evidence_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "specimen_text": {
      "type": "string",
      "minLength": 1
    },
    "naming": {
      "type": "object",
      "properties": {
        "primitive": {
          "type": "object",
          "required": [
            "parts"
          ],
          "properties": {
            "separator": {
              "type": "string"
            },
            "parts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "text",
                  "label"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "semantic": {
          "type": "object",
          "required": [
            "parts"
          ],
          "properties": {
            "separator": {
              "type": "string"
            },
            "parts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "text",
                  "label"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "breakpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "min_width"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "min_width": {
            "type": "string",
            "minLength": 1,
            "description": "A CSS value traced to evidence, or \"unknown\"."
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "basis": {
            "enum": [
              "observed",
              "hypothesis"
            ],
            "description": "observed (default): traced to project or rendered evidence. hypothesis: a new-system design choice; requires rationale and is allowed only in new-system mode."
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "description": "Why a hypothesis value was chosen, tied to stated requirements, content, brand, or platform constraints."
          },
          "based_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "Question IDs whose recorded answers shaped this value. A delegated answer cannot be cited."
          }
        }
      }
    },
    "foundations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "color": {
          "type": "object",
          "properties": {
            "primitives": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "value",
                  "evidence"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "description": "A CSS color in hex, rgb(), rgba(), or oklch(), or \"unknown\". Contrast and the converted notations are computed for these formats only."
                  },
                  "group": {
                    "type": "string",
                    "minLength": 1
                  },
                  "step": {
                    "type": "string",
                    "minLength": 1
                  },
                  "specimen": {
                    "type": "string",
                    "minLength": 1
                  },
                  "current_values": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "basis": {
                    "enum": [
                      "observed",
                      "hypothesis"
                    ],
                    "description": "observed (default): traced to project or rendered evidence. hypothesis: a new-system design choice; requires rationale and is allowed only in new-system mode."
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Why a hypothesis value was chosen, tied to stated requirements, content, brand, or platform constraints."
                  },
                  "based_on": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "description": "Question IDs whose recorded answers shaped this value. A delegated answer cannot be cited."
                  }
                }
              }
            },
            "semantic": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "role",
                  "references",
                  "status"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:[-.][a-z0-9]+)*$"
                  },
                  "role": {
                    "type": "string",
                    "minLength": 1
                  },
                  "references": {
                    "type": "object",
                    "minProperties": 1,
                    "description": "Context (default, a breakpoint, a language, or a theme) mapped to a primitive name or \"unknown\".",
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "usage": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "enum": [
                      "proposed",
                      "retained",
                      "unknown"
                    ]
                  },
                  "contrast": {
                    "type": "object",
                    "required": [
                      "against",
                      "minimum"
                    ],
                    "properties": {
                      "against": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minimum": {
                        "type": "number",
                        "exclusiveMinimum": 1
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "typography": {
          "type": "object",
          "properties": {
            "primitives": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
