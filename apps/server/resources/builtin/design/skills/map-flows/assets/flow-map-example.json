{
  "schema_version": "1.0",
  "map": "log-workout",
  "title": "Log a workout",
  "product": "Example workout log app (flow-app fixture)",
  "scope": "From the Today screen to a saved workout, including discarding a workout. Sign-in, the exercise library, and history are out of scope.",
  "facts": [
    {
      "id": "has-sets",
      "description": "At least one set is logged in the active workout."
    },
    {
      "id": "offline",
      "description": "The device cannot reach the server when the workout is saved."
    },
    {
      "id": "reps-missing",
      "description": "The person submits the set form without entering reps."
    }
  ],
  "states": [
    {
      "id": "today",
      "kind": "screen",
      "label": "Today",
      "route": "today.html"
    },
    {
      "id": "workout",
      "kind": "screen",
      "label": "Active workout",
      "route": "workout.html"
    },
    {
      "id": "set-form",
      "kind": "overlay",
      "label": "Add set form"
    },
    {
      "id": "set-error",
      "kind": "inline",
      "role": "failure",
      "label": "Reps missing"
    },
    {
      "id": "more-menu",
      "kind": "overlay",
      "label": "More menu"
    },
    {
      "id": "save-failed",
