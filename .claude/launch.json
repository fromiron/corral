{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "studio",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@corral/studio",
        "exec",
        "vite",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "live",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["corral", "dev"],
      "port": 4317
    },
    {
      "name": "storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@corral/react",
        "exec",
        "storybook",
        "dev",
        "-p",
        "6006",
        "--ci",
        "--no-open"
      ],
      "port": 6006
    }
  ]
}
