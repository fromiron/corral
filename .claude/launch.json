{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "studio",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@corral/studio",
        "exec",
        "vite",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "live",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["corral", "dev"],
      "port": 4317
    },
    {
      "name": "live-server",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/server/src/main.ts",
        "--workspace",
        ".",
        "--allow-origin",
        "http://localhost:5173",
        "--mock-delay",
        "0"
      ],
      "port": 4317
    },
    {
      "name": "verify-server",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/server/src/main.ts",
        "--workspace",
        "/tmp/claude-1000/-home-bell-Toys-corral/5bebd76a-1595-49d8-b0fe-b4055c10e802/scratchpad/verify-ws",
        "--allow-origin",
        "http://localhost:5173",
        "--no-live",
        "--mock-delay",
        "50"
      ],
      "port": 4317
    },
    {
      "name": "live-hmr",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "CORRAL_SERVER=http://127.0.0.1:4317",
        "pnpm",
        "--filter",
        "@corral/studio",
        "exec",
        "vite",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "editor-concepts",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4400", "--bind", "127.0.0.1", "--directory", "prototypes/team-editor"],
      "port": 4400
    },
    {
      "name": "storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@corral/react",
        "exec",
        "storybook",
        "dev",
        "-p",
        "6006",
        "--ci",
        "--no-open"
      ],
      "port": 6006
    }
  ]
}
