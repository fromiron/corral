{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "targetArtifactVersionId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
        },
        "criteriaVersionId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
        },
        "evidenceRefs": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
          }
        },
        "design": {
          "type": "object",
          "properties": {
            "reportVersionId": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
            },
            "tokenProposalVersionId": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
            },
            "preferences": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "origin": {
                        "type": "string",
                        "const": "ai_delegated"
                      },
                      "appliedTo": {
                        "minItems": 1,
                        "maxItems": 30,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        }
                      }
                    },
                    "required": [
                      "origin",
                      "appliedTo"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "origin": {
                        "type": "string",
                        "const": "user_answer"
                      },
                      "requestId": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
                      },
                      "questionId": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
                      },
                      "appliedTo": {
                        "minItems": 1,
                        "maxItems": 30,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        }
                      }
                    },
                    "required": [
                      "origin",
                      "requestId",
                      "questionId",
                      "appliedTo"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "required": [
            "reportVersionId",
            "preferences"
          ],
          "additionalProperties": false
        },
        "verdict": {
          "type": "string",
          "const": "revise"
        },
        "issues": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterionId": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "string",
                "enum": [
                  "required",
                  "advisory"
                ]
              },
              "evidenceRefs": {
                "maxItems": 30,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
                }
              }
            },
            "required": [
              "criterionId",
              "reason",
              "severity",
              "evidenceRefs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "targetArtifactVersionId",
        "criteriaVersionId",
        "evidenceRefs",
        "verdict",
        "issues"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
