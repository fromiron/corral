{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1"
    },
    "commandId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
    },
    "corralId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
    },
    "definitionRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "input": {
      "type": "object",
      "properties": {
        "brief": {
          "type": "string",
          "minLength": 1
        },
        "criteria": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "brief",
        "criteria"
      ],
      "additionalProperties": false
    },
    "mode": {
      "type": "string",
      "enum": [
        "mock",
        "live"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "commandId",
    "corralId",
    "definitionRevision",
    "mode"
  ],
  "additionalProperties": false,
  "$id": "urn:corral:create-run:0.1",
  "title": "CreateRunRequest"
}
