                      },
                      "hostId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "projectId": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
                      },
                      "sessionId": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
                      },
                      "verificationId": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
                      },
                      "commandId": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
                      },
                      "tree": {
                        "type": "string",
                        "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                      },
                      "fingerprint": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "configRevision": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "outputHash": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "outputTruncated": {
                        "type": "boolean"
