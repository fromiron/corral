{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1"
    },
    "commandId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
    },
    "corralId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
    },
    "definitionRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "input": {
      "type": "object",
      "properties": {
        "images": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "image_attachment"
              },
              "imageId": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[^/\\\\\\p{Cc}]+$"
              },
              "mime": {
                "type": "string",
                "const": "image/png"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048576
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2048
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2048
              }
            },
            "required": [
              "kind",
              "imageId",
              "name",
              "mime",
              "bytes",
              "sha256",
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        },
        "taskScope": {
          "type": "string",
          "enum": [
            "work",
            "review_only"
          ]
        },
        "verificationScope": {
          "type": "string",
          "enum": [
            "targeted",
            "release"
          ]
        },
        "brief": {
          "type": "string",
          "minLength": 1
        },
        "criteria": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "brief",
        "criteria"
      ],
      "additionalProperties": false
    },
    "mode": {
      "type": "string",
      "enum": [
        "mock",
        "live"
      ]
    },
    "startFrom": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
        },
        "artifactVersionId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
        }
      },
      "required": [
        "runId",
        "artifactVersionId"
      ],
      "additionalProperties": false
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
    },
    "references": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "image_attachment"
              },
              "imageId": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[^/\\\\\\p{Cc}]+$"
              },
              "mime": {
                "type": "string",
                "const": "image/png"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048576
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2048
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2048
              }
            },
            "required": [
              "kind",
              "imageId",
              "name",
              "mime",
              "bytes",
              "sha256",
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "text_attachment"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[^/\\\\\\p{Cc}]+$"
              },
              "mime": {
                "type": "string",
                "enum": [
                  "text/plain",
                  "text/markdown",
                  "application/json",
                  "text/csv"
                ]
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65536
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "text": {
                "type": "string",
                "maxLength": 65536,
                "pattern": "^[^\\p{Cs}\\0]*$"
              }
            },
            "required": [
              "kind",
              "name",
              "mime",
              "bytes",
              "sha256",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "file"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "lines": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "path"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "folder"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "kind",
              "path"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "result"
              },
              "runId": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
              },
              "artifactVersionId": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
              }
            },
            "required": [
              "kind",
              "runId",
              "artifactVersionId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "run"
              },
              "runId": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
              }
            },
            "required": [
              "kind",
              "runId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "role"
              },
              "roleId": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
              }
            },
            "required": [
              "kind",
              "roleId"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "harnessOverrides": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "profileId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "profileId",
          "revision"
        ],
        "additionalProperties": false
      },
      "maxProperties": 20
    },
    "roleOverrides": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "modelProfile": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
          },
          "reasoning": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "fixed"
                  },
                  "level": {
                    "type": "string",
                    "enum": [
                      "off",
                      "minimal",
                      "low",
                      "medium",
                      "high",
                      "xhigh",
                      "max"
                    ]
                  }
                },
                "required": [
                  "mode",
                  "level"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "auto"
                  }
                },
                "required": [
                  "mode"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "provider_default"
                  }
                },
                "required": [
                  "mode"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "commandId",
    "corralId",
    "definitionRevision",
    "mode"
  ],
  "additionalProperties": false,
  "$id": "urn:corral:create-run:0.1",
  "title": "CreateRunRequest"
}
