                          },
                          "projectId": {
                            "type": "string",
                            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
                          },
                          "bindingId": {
                            "type": "string",
                            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
                          },
                          "sessionId": {
                            "type": "string",
                            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
                          },
                          "copyGeneration": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          }
