                      "generation": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
                      },
                      "outputSequence": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
