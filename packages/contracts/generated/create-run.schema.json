                      },
                      "target": {
                        "type": "object",
                        "properties": {
                          "hostId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "projectId": {
                            "type": "string",
                            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
                          },
                          "bindingId": {
                            "type": "string",
                            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
                          },
                          "sessionId": {
                            "type": "string",
                            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
                          },
                          "copyGeneration": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "hostId",
                          "projectId",
                          "bindingId",
                          "sessionId",
                          "copyGeneration"
                        ],
                        "additionalProperties": false
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "snapshot": {
                        "type": "string",
                        "enum": [
                          "saved",
                          "draft"
                        ]
                      },
                      "baseHash": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "bufferHash": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "editVersion": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "range": {
                        "type": "object",
                        "properties": {
                          "startLine": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
