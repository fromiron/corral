              "imageId",
              "name",
              "mime",
              "bytes",
              "sha256",
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "text_attachment"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[^/\\\\\\p{Cc}]+$"
              },
              "mime": {
                "type": "string",
                "enum": [
                  "text/plain",
                  "text/markdown",
                  "application/json",
                  "text/csv"
