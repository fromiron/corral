                        "maximum": 500
                      },
                      "range": {
                        "type": "object",
                        "properties": {
                          "startRow": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "startColumn": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "endRow": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "endColumn": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "startRow",
                          "startColumn",
                          "endRow",
                          "endColumn"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "kind",
                      "target",
                      "terminalId",
                      "generation",
                      "outputSequence",
                      "buffer",
                      "cols",
                      "rows",
                      "range"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "hunk"
                      },
                      "hostId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "projectId": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
                      },
                      "sessionId": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
                      },
                      "from": {
                        "type": "string",
                        "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                      },
                      "to": {
                        "type": "string",
                        "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "patchHash": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "hunkIds": {
                        "minItems": 1,
                        "maxItems": 200,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      }
                    },
                    "required": [
                      "kind",
                      "hostId",
                      "projectId",
                      "sessionId",
                      "from",
                      "to",
                      "path",
                      "patchHash",
                      "hunkIds"
                    ],
                    "additionalProperties": false
                  },
