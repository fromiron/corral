                          "startColumn": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "endLine": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "endColumn": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "startLine",
                          "startColumn",
                          "endLine",
                          "endColumn"
                        ],
                        "additionalProperties": false
                      }
