{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "permissionMode": {
      "type": "string",
      "enum": [
        "ask",
        "accept_edits",
        "auto"
      ]
    },
    "schemaVersion": {
      "type": "string",
      "const": "0.1"
    },
    "commandId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
    },
    "corralId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
    },
    "definitionRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "input": {
      "type": "object",
      "properties": {
        "images": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "image_attachment"
              },
              "imageId": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[^/\\\\\\p{Cc}]+$"
              },
              "mime": {
                "type": "string",
                "const": "image/png"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048576
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2048
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2048
              }
            },
            "required": [
              "kind",
              "imageId",
              "name",
              "mime",
              "bytes",
              "sha256",
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        },
        "taskScope": {
          "type": "string",
          "enum": [
            "work",
            "review_only"
          ]
        },
        "verificationScope": {
          "type": "string",
          "enum": [
            "targeted",
            "release"
          ]
        },
        "brief": {
          "type": "string",
          "minLength": 1
        },
        "criteria": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "brief",
        "criteria"
      ],
      "additionalProperties": false
    },
    "mode": {
      "type": "string",
      "enum": [
        "mock",
        "live"
      ]
    },
    "startFrom": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
        },
        "artifactVersionId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
        }
      },
      "required": [
        "runId",
        "artifactVersionId"
      ],
      "additionalProperties": false
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
    },
    "references": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "image_attachment"
              },
              "imageId": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,119}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[^/\\\\\\p{Cc}]+$"
              },
              "mime": {
                "type": "string",
                "const": "image/png"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048576
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2048
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2048
              }
